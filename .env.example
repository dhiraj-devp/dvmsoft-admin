APP_NAME="Dvmsoft Admin OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Local default: same origin as APP_URL (staff at /login, client at /client).
# Single live subdomain:
# ADMIN_URL=https://app.dvmsoft.in
# CLIENT_URL=https://app.dvmsoft.in
# Dedicated hosts for production / Herd:
# ADMIN_URL=http://admin.dvmsoft.test
# CLIENT_URL=http://client.dvmsoft.test
ADMIN_URL=http://127.0.0.1:8000
CLIENT_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dvmsoft_admin
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty so cookies stay host-only and are not shared between admin and client hosts.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
ADMIN_SESSION_COOKIE=dvmsoft-admin-session
CLIENT_SESSION_COOKIE=dvmsoft-client-session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@dvmsoft.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@dvmsoft.local
ADMIN_PASSWORD=password

AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT=20
AI_MAX_TOKENS=1200
